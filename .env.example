# ── Core ─────────────────────────────────────────────
APP_ENV=dev
APP_SECRET=replace-with-32-random-bytes
DATABASE_URL=postgresql://hecai:hecai@localhost:5432/hecai
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
TENANT_DEFAULT_SLUG=hec

# ── AI ───────────────────────────────────────────────
LLM_PROVIDER=anthropic            # anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=                   # also used for Whisper voice notes + OpenAI embeddings
LLM_MODEL=                        # default claude-opus-5 (Anthropic) / gpt-4o (OpenAI)
EMBEDDING_PROVIDER=openai         # openai (text-embedding-3-large) | voyage (voyage-3-large)
VOYAGE_API_KEY=
COHERE_API_KEY=                   # optional: Cohere rerank-v3.5

# ── WhatsApp Cloud API (via your BSP) ────────────────
WHATSAPP_VERIFY_TOKEN=choose-a-verify-token
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# ── Payments ─────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Observability ────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Business rules ───────────────────────────────────
TARGET_MARGIN_PCT=40
MIN_MARGIN_PCT=32
MAX_GUESTS=500
GST_PCT=5
ADVANCE_PCT=30
PRICE_INGEST_CRON=0 * * * *
# Optional live price feeds (must be licensed/allowed): JSON endpoint or CSV path
PRICE_SOURCE_URL=
PRICE_SOURCE_LABEL=market_feed
PRICE_SOURCE_AUTH=
PRICE_SOURCE_CSV=
RUN_SCHEDULER=1
