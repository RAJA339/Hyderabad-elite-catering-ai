# ─────────────────────────────────────────────────────────
# Core
# ─────────────────────────────────────────────────────────
APP_ENV=dev
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET=replace-with-32-random-bytes
DATABASE_URL=postgresql://hecai:hecai@localhost:5432/hecai
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:3000
TENANT_DEFAULT_SLUG=hec

# ─────────────────────────────────────────────────────────
# AI. Set ONE of the two keys below and match LLM_PROVIDER.
# NOTE: never put a comment on the same line as a value.
# "KEY=   # note" is read as the literal text "# note".
# ─────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Only for identity-linked keys, which are rejected without it. If startup reports
# "anthropic-workspace-id is required", copy the id from the Claude Console under
# Settings then Workspaces. Leave empty for an ordinary API key.
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=
# Leave LLM_MODEL empty for the default: claude-opus-5, or gpt-4o on OpenAI.
LLM_MODEL=
# Thinking depth and spend: low | medium | high | xhigh | max
LLM_EFFORT=medium
LLM_MAX_TOKENS=8000

# Embeddings: openai (text-embedding-3-large) or voyage (voyage-3-large).
# Must stay the same for indexing and querying.
EMBEDDING_PROVIDER=openai
VOYAGE_API_KEY=
# Optional: enables Cohere rerank-v3.5. A local cross-encoder is used otherwise.
COHERE_API_KEY=

# ─────────────────────────────────────────────────────────
# WhatsApp Cloud API, via Meta or your BSP.
# Leave empty to run locally without WhatsApp.
# ─────────────────────────────────────────────────────────
WHATSAPP_VERIFY_TOKEN=choose-a-verify-token
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# ─────────────────────────────────────────────────────────
# Payments (Razorpay). Optional until you take real money.
# ─────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─────────────────────────────────────────────────────────
# Observability (LangFuse). Optional.
# ─────────────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ─────────────────────────────────────────────────────────
# Business rules. Yours to decide, not credentials.
# ─────────────────────────────────────────────────────────
TARGET_MARGIN_PCT=40
MIN_MARGIN_PCT=32
MAX_GUESTS=500
GST_PCT=5
ADVANCE_PCT=30
PRICE_INGEST_CRON=0 * * * *
RUN_SCHEDULER=1

# ─────────────────────────────────────────────────────────
# Optional live market price feed. Must be licensed or your own.
# JSON endpoint, or a CSV path your purchase team updates.
# ─────────────────────────────────────────────────────────
PRICE_SOURCE_URL=
PRICE_SOURCE_LABEL=market_feed
PRICE_SOURCE_AUTH=
PRICE_SOURCE_CSV=
